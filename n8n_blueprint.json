            "index": 0
          }
        ]
      ]
    },
    "Analyze new clips": {
      "main": [
        [
          {
            "node": "Make videos",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Make videos": {
      "main": [
