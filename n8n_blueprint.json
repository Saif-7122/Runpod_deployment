{
  "name": "Content Engine v1.2",
  "nodes": [
    {
      "parameters": {},
      "id": "a1",
      "name": "Start",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        200,
        300
      ]
    },
    {
      "parameters": {
        "values": {
          "number": [
            {
              "name": "variants",
              "value": 10
            },
            {
              "name": "parallel",
              "value": 8
            }
          ],
          "string": [
            {
              "name": "brief",
              "value": "brief.json"
            }
          ]
        },
        "options": {}
      },
      "id": "a2",
      "name": "Batch settings",
      "type": "n8n-nodes-base.set",
      "typeVersion": 1,
      "position": [
        420,
        300
      ]
    },
    {
      "parameters": {
        "command": "bash -lc 'source /workspace/ce_env.sh && cd /workspace && python3 analyze.py --drive 2>&1 | tail -5'"
      },
      "id": "a3",
      "name": "Analyze new clips",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [
        640,
        300
      ]
    },
    {
      "parameters": {
        "command": "=bash -lc 'source /workspace/ce_env.sh && cd /workspace && python3 run.py --brief {{$node[\"Batch settings\"].json[\"brief\"]}} --variants {{$node[\"Batch settings\"].json[\"variants\"]}} --parallel {{$node[\"Batch settings\"].json[\"parallel\"]}} --upload --cleanup 2>/workspace/data/last_run.log | tail -1'"
      },
      "id": "a4",
      "name": "Make videos",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [
        860,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "const lines = $input.first().json.stdout.trim().split(/\\r?\\n/);\nreturn [{ json: JSON.parse(lines[lines.length - 1]) }];"
      },
      "id": "a5",
      "name": "Batch result",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1080,
        300
      ]
    }
  ],
  "connections": {
    "Start": {
      "main": [
        [
          {
            "node": "Batch settings",
            "type": "main",
            "index": 0
          }
        ]
