# Copy to .env and fill in. Never commit .env.
ANTHROPIC_API_KEY=
SARVAM_API_KEY=

# Google Drive - option A (recommended): your own Google account via OAuth
GOOGLE_OAUTH_CLIENT_FILE=client_secret.json
GOOGLE_TOKEN_FILE=token.json
# Google Drive - option B: service account (uploads only work into a Shared Drive)
# GOOGLE_SERVICE_ACCOUNT_FILE=service_account.json

# Only if your Claude key is not scoped to a workspace (console > Settings > Workspaces > ID, wrkspc_...)
ANTHROPIC_WORKSPACE_ID=
